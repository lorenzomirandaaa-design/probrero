# Copy these into Netlify → Site configuration → Environment variables.
# Never put the secret ones in the website files or share them.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" key (safe to be public)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # "service_role" key (SECRET)

# Stripe → Developers → API keys (use sk_test_ while testing)
STRIPE_SECRET_KEY=sk_test_...       # SECRET
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...     # SECRET

# Optional: Probrero's fee per card payment (default 3.9% + 30 cents)
# PLATFORM_FEE_PERCENT=3.9
# PLATFORM_FEE_FLAT_CENTS=30
